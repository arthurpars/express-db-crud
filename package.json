{
  "name": "express-db-crud",
  "version": "1.0.0",
  "description": "Full CRUD across PostgreSQL (Prisma), MongoDB (Mongoose), and Redis (ioredis)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "prisma migrate dev --name init",
    "generate": "prisma generate",
    "seed": "node scripts/seed.js",
    "seed:pg": "prisma db seed",
    "seed:mongo": "node src/seeds/mongo-seed.js",
    "seed:redis": "node src/seeds/redis-seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0"
  }
}
